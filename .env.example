# All variables are optional and read at build time (static export).
# Copy to .env.local for local builds; in CI add them as repository
# variables (Settings → Secrets and variables → Actions → Variables).
# Anything left empty is hidden from the UI.

# Canonical site origin + base path, no trailing slash. Used for metadata,
# canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://pratik-aep.github.io/portfolio

# Contact form. With an endpoint the form POSTs JSON
# ({ name, email, service, message, subject }) and shows sending, success
# and error states. Works with Formspree (https://formspree.io/f/<id>) or
# Web3Forms (https://api.web3forms.com/submit + access key below).
NEXT_PUBLIC_FORM_ENDPOINT=
# Web3Forms only. This key is designed to be public.
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Contact email. Without a form endpoint the form opens an email draft to
# this address; it is also the error fallback and appears with the socials.
# With neither set, the form saves the brief as a local file (nothing sent).
NEXT_PUBLIC_CONTACT_EMAIL=

# "Book a call" (Cal.com / Calendly link) and "Download résumé".
# A résumé in public/ can be referenced as /resume.pdf.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_RESUME_URL=

# Social profiles (full URLs).
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
